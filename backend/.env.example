# Pulsecast Backend Environment Variables

# Groq API Key (required for AI explanations)
GROQ_API_KEY=your_groq_api_key_here

# Groq model. Override this only with a model currently supported by Groq.
LLM_MODEL=openai/gpt-oss-120b

# Optional NVIDIA NIM fallback
NVIDIA_API_KEY=

# Debug mode
DEBUG=false

# Database path (SQLite)
DB_PATH=./pulsecast.db
